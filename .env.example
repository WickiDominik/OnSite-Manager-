# Optional: Plattform-Anmeldung (Supabase Auth). Ohne diese Werte läuft die App im lokalen Modus ohne Login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# BimCollab-Anbindung (Login + Abgleich). Vorübergehend deaktiviert; auf true setzen, um sie wieder einzuschalten.
VITE_BIMCOLLAB_ENABLED=false

# OneDrive-Import (Microsoft Graph). Optionaler Vorgabewert; kann auch in der App unter Einstellungen → Cloud-Speicher eingetragen werden.
VITE_ONEDRIVE_CLIENT_ID=
# Firmen-Domain oder Mandanten-ID (z. B. schaerholzbau.ch). Leer = common.
VITE_ONEDRIVE_TENANT=
