{
  "name": "bcf-onsite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BCF-OnSite – mobile Bauabnahmen und Mängelmanagement mit BimCollab-Anbindung",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "web-ifc": "^0.0.78"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
